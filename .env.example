# ============================================
# OCS 自建 AI 题库 · 配置
# ============================================

# [必填] DeepSeek API Key
# 获取地址：https://platform.deepseek.com （注册后充值，10 元可用很久）
# 注意：直接粘贴在等号右边，不要加引号，不要留空格
DEEPSEEK_API_KEY=

# 模型名称
#   deepseek-chat      便宜快，推荐
#   deepseek-reasoner  更准但慢且贵
DEEPSEEK_MODEL=deepseek-chat

# API 地址，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 服务端口，若 8000 被占用可改成 8001
PORT=8000

# [强烈建议] 接口访问令牌，设成随机字符串
# 服务监听 0.0.0.0，不设令牌时同局域网的人知道你 IP 就能盗用你的额度
# 设置后，OCS 脚本的题库设置里也要填同一个值
API_TOKEN=
